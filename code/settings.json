{

    // startup
    // "workbench.editor.restoreViewState": false, // que no recuerde donde estaba mi cursor
    "window.restoreWindows": "one", // Solo restaura el ultimo proyecto
    "workbench.startupEditor": "none", // No abre ninguna pagina especial al iniciar
    "workbench.editor.restoreEditors": false, // No restaura los archivos que estaban abiertos en cada proyecto
    "telemetry.telemetryLevel": "off",
    "extensions.autoCheckUpdates": false,
    "extensions.autoUpdate": "off",

    // PREFERENCES
    // "editor.inlineSuggest.enabled": false, // desactivar tab completion
    "chat.disableAIFeatures": true, // la mejor config
    "editor.fontFamily": "JetBrains Mono",
    "window.autoDetectColorScheme": true,
    "editor.fontLigatures": true,
    "workbench.sideBar.location": "right",
    "editor.lineNumbers": "relative",
    "editor.dragAndDrop": false,
    "editor.minimap.enabled": false,
    "extensions.ignoreRecommendations": true,
    "breadcrumbs.enabled": false,
    "editor.quickSuggestions": { "other": "on" },
    
    // SHELL
    "terminal.integrated.profiles.windows": { "PowerShell 7": { "path": "C:\\Users\\juancarlos.molero\\AppData\\Local\\Programs\\powershell\\pwsh.exe" } },
    "terminal.integrated.defaultProfile.windows": "PowerShell 7",
    "python.terminal.activateEnvironment": false,

    // PYTHON
    "python.analysis.typeCheckingMode": "standard",
    "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },
    "ruff.lint.enable": false,
    "jupyter.askForKernelRestart": false,

    // sql
    "[sql]": {
        "editor.codeLens": false,
        "editor.wordBasedSuggestions": "allDocuments",
        "editor.suggest.showWords": true
    },

    // VIM
    "vim.leader": " ",
    "vim.useSystemClipboard": false,
    "vim.highlightedyank.enable": true,
    "vim.highlightedyank.duration": 200,
    "extensions.experimental.affinity": { "vscodevim.vim": 1 },
    "vim.visualModeKeyBindings": [
        { "before": ["J"], "after": [ "j" ] },
        { "before": ["<leader>", "y"], "commands": [{ "command": "editor.action.clipboardCopyAction" }, { "command": "extension.vim_escape" }] },
        { "before": ["g", "j"], "commands": [{ "command": "editor.action.joinLines" }, { "command": "extension.vim_escape" }] },
        { "before": ["H"], "commands": [{ "command": "editor.action.moveLinesUpAction" }] },
        { "before": ["M"], "commands": [{ "command": "editor.action.moveLinesDownAction" }] },
        { "before": ["W"], "after": [ "<nop>" ] }
    ],
    "vim.normalModeKeyBindings": [
        { "before": ["[", "d"], "commands": [{ "command": "editor.action.marker.prev" }] },
        { "before": ["]", "d"], "commands": [{ "command": "editor.action.marker.next" }] },
        { "before": ["g", "n"], "commands": [{ "command": "workbench.files.action.showActiveFileInExplorer" }] },
        { "before": ["<leader>", ","], "commands": [{ "command": "workbench.view.scm" }, { "command": "workbench.cm.action.focusNextResourceGroup" }] },
        // { "before": ["g", "/"], "commands": [{ "command": "workbench.action.findInFiles }] },
        { "before": ["K"], "commands": [{ "command": "editor.action.showHover" }] },
        { "before": ["<C-w>", "a"], "commands": [{ "command": "workbench.action.closeEditorsInGroup" }] },
        { "before": ["<C-w>", "O"], "commands": [{ "command": "workbench.action.closeOtherEditors" }] },
        { "before": ["s"], "after": ["<Esc>", ":", "w", "<CR>"] },
        { "before": ["<leader>", "f"], "commands": [{ "command": "editor.action.formatDocument" }] },
        { "before": ["u"], "commands": [{ "command": "undo" }] },
        { "before": ["<C-r>"], "commands": [{ "command": "redo" }] },
        { "before": ["c", "i", "o"], "after": ["_", "f", "*", "a", "<backspace>"] },

        { "before": ["<C-b>"], "after": [ "<nop>" ] },
        { "before": ["<C-w><C-c>"], "after": [ "<nop>" ] },
        { "before": ["<C-w>", "c"], "after": [ "<nop>" ] }
    ],
}