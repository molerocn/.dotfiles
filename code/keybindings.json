[

    // disable
    { "key": "ctrl+p", "command": "-extension.vim_ctrl+p" },
    { "key": "ctrl+w", "command": "-workbench.action.closeActiveEditor" },
    { "key": "ctrl+p", "command": "-workbench.action.quickOpen" },
    { "key": "ctrl+space", "command": "-workbench.action.terminal.triggerSuggest", "when": "config.terminal.integrated.suggest.enabled && terminalFocus && terminalProcessSupported && !terminalSuggestWidgetVisible" },
    { "key": "ctrl+-", "command": "-workbench.action.zoomOut" },
    { "key": "ctrl+=", "command": "-workbench.action.zoomIn" },
    { "key": "enter", "command": "-acceptSelectedSuggestion", "when": "acceptSuggestionOnEnter && suggestWidgetHasFocusedSuggestion && suggestWidgetVisible && suggestionMakesTextEdit && textInputFocus" },
    // { "key": "escape", "command": "-notebook.cell.quitEdit", "when": "inputFocus && notebookEditorFocused && vim.active && !editorHasSelection && !editorHoverVisible && vim.mode == 'Normal'" },
    { "key": "ctrl+shift+p", "command": "-workbench.action.showCommands" },
    // { "key": "ctrl+h", "command": "-editor.action.startFindReplaceAction", "when": "editorFocus || editorIsOpen" },
    // { "key": "ctrl+h", "command": "-extension.vim_ctrl+h", "when": "editorTextFocus && vim.active && vim.use<C-h> && !inDebugRepl" },
    { "key": "ctrl+shift+o", "command": "-workbench.action.gotoSymbol", "when": "!accessibilityHelpIsShown && !accessibleViewIsShown" },
    { "key": "ctrl+shift+m", "command": "-workbench.actions.view.problems", "when": "workbench.panel.markers.view.active" },
    { "key": "b", "command": "-notebook.cell.insertCodeCellBelowAndFocusContainer", "when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused" },
    { "key": "a", "command": "-notebook.cell.insertCodeCellAboveAndFocusContainer", "when": "notebookEditorFocused && !inputFocus && !notebookOutputInputFocused" },

    // global
    { "key": "ctrl+e", "command": "workbench.action.terminal.toggleTerminal" },
    { "key": "ctrl+.", "command": "runCommands", "args": { "commands": [ "workbench.action.closePanel", "workbench.action.closeSidebar" ] } },
    { "key": "ctrl+f", "command": "workbench.action.openRecent" },
    { "key": "ctrl+p", "command": "workbench.action.quickOpen", "when": "!terminalFocus" },
    { "key": "ctrl+3", "command": "runCommands", "args": { "commands": [ "workbench.action.closePanel", "workbench.action.closeSidebar", "workbench.view.extension.dbcodePanelContainer" ] } }, { "key": "ctrl+space", "command": "workbench.action.focusFirstEditorGroup", "when": "!terminalFocus" },
    { "key": "ctrl+shift+p", "command": "workbench.action.showCommands", "when": "!notebookEditorFocused" },

    // editor
    { "key": "ctrl+m", "command": "workbench.action.previousEditorInGroup" },
    { "key": "ctrl+shift+tab", "command": "workbench.action.previousEditorInGroup" },
    { "key": "ctrl+t", "command": "workbench.action.nextEditorInGroup" },
    { "key": "ctrl+tab", "command": "workbench.action.nextEditorInGroup" },
    { "key": "ctrl+,", "command": "workbench.action.closeActiveEditor" },
    { "key": "ctrl+s", "command": "runCommands", "args": { "commands": [ "saveAll", "extension.vim_ctrl+c", ], },  "when": "editorFocus"},

    // suggestion
    { "key": "ctrl+y", "command": "acceptSelectedSuggestion", "when": "suggestWidgetVisible" },
    { "key": "ctrl+p", "command": "selectPrevSuggestion", "when": "suggestWidgetVisible" },

    // quickopen
    { "key": "ctrl+n", "command": "workbench.action.quickOpenSelectNext", "when": "inQuickOpen" },
    { "key": "ctrl+p", "command": "workbench.action.quickOpenSelectPrevious", "when": "inQuickOpen" },
    { "key": "ctrl+c", "command": "workbench.action.closeQuickOpen", "when": "inQuickOpen" },
    { "key": "ctrl+u", "command": "editor.action.selectAll", "when": "inQuickOpen" },

    // terminal
    { "key": "ctrl+shift+n", "command": "workbench.action.terminal.new", "when": "terminalFocus"  },
    { "key": "ctrl+h", "command": "workbench.action.terminal.focusPrevious", "when": "terminalFocus" },
    { "key": "ctrl+t", "command": "workbench.action.terminal.focusNext", "when": "terminalFocus"  },
    { "key": "ctrl+g", "command": "workbench.action.focusFirstEditorGroup", "when": "terminalFocus" },

    // explorer
    { "key": "a", "command": "workbench.files.action.createFileFromExplorer", "when": "filesExplorerFocus && !inputFocus" },
    { "key": "d", "command": "workbench.files.action.createFolderFromExplorer", "when": "filesExplorerFocus && !inputFocus" },
    { "key": "r", "command": "renameFile", "when": "filesExplorerFocus && !inputFocus" },
    { "key": "shift+d", "command": "moveFileToTrash", "when": "filesExplorerFocus && !inputFocus" },

    // windows
    { "key": "ctrl+u", "command": "workbench.action.terminal.sendSequence", "args": { "text": "\u001b" }, "when": "isWindows && terminalFocus" },
    { "key": "ctrl+p", "command": "workbench.action.terminal.sendSequence", "args": { "text": "\u001b[A" }, "when": "isWindows && terminalFocus" },
    { "key": "ctrl+n", "command": "workbench.action.terminal.sendSequence", "args": { "text": "\u001b[B" }, "when": "isWindows && terminalFocus" },
    { "key": "tab", "command": "workbench.action.terminal.sendSequence", "args": { "text": "\u0009" }, "when": "isWindows && terminalFocus" },
    { "key": "ctrl+space", "command": "workbench.action.terminal.sendSequence", "args": { "text": "\u001b[C" }, "when": "isWindows && terminalFocus" },

    // notebook
    // { "key": "ctrl+h", "command": "runCommands", "args": { "commands": [ "extension.vim_escape", "notebook.cell.quitEdit" ] }, "when": "inputFocus && notebookEditorFocused && !editorHasMultipleSelections && !editorHasSelection && !editorHoverVisible && !inlineChatFocused" },
    // { "key": "shift+enter", "command": "runCommands", "args": { "commands": [ "extension.vim_escape", "notebook.cell.executeAndSelectBelow" ] }, "when": "notebookCellListFocused && !interactiveEditorFocused && notebookCellType == 'code' || editorTextFocus && inputFocus && notebookEditorFocused && !interactiveEditorFocused" },
    { "key": "shift+enter", "command": "runCommands", "args": { "commands": [ "notebook.cell.executeAndSelectBelow", "notebook.cell.edit" ] }, "when": "notebookEditorFocused" },
    { "key": "enter", "command": "runCommands", "args": { "commands": [ "notebook.cell.edit", "extension.vim_escape" ] }, "when": "notebookCellListFocused && !editorHoverFocused && !inputFocus && !notebookOutputInputFocused" },
    { "key": "ctrl+enter", "command": "runCommands", "args": { "commands": [ "extension.vim_escape", "notebook.cell.executeAndFocusContainer", "notebook.cell.edit" ] }, "when": "notebookCellListFocused || editorTextFocus && inputFocus && notebookEditorFocused" },
    { "key": "ctrl+shift+,", "command": "notebook.cell.delete", "when": "notebookEditorFocused" },
    { "key": "ctrl+shift+p", "command": "runCommands", "args": { "commands": [ "extension.vim_escape", "notebook.cell.insertCodeCellBelowAndFocusContainer", "notebook.cell.edit" ] }, "when": "notebookEditorFocused" },
    { "key": "ctrl+shift+o", "command": "runCommands", "args": { "commands": [ "extension.vim_escape", "notebook.cell.insertCodeCellAboveAndFocusContainer", "notebook.cell.edit" ] }, "when": "notebookEditorFocused" },
    { "key": "ctrl+shift+m", "command": "runCommands", "args": { "commands": [ "notebook.cell.changeToMarkdown", "notebook.cell.edit" ] }, "when": "notebookEditorFocused && notebookCellType == 'code'" },
    { "key": "ctrl+shift+m", "command": "runCommands", "args": { "commands": [ "notebook.cell.changeToCode", "notebook.cell.edit" ] }, "when": "notebookEditorFocused && notebookCellType == 'markup'" },
]